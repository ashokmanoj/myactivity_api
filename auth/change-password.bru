meta {
  name: Change Password
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/auth/change-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mobileNumber": "9999999999",
    "oldPassword":  "Pass@123",
    "newPassword":  "Test@123",
    "company":      "ICT Program 2025"
  }
}

vars:pre-request {
  base_url: http://192.168.1.128:5000
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("password changed", function() { expect(res.getBody().message).to.include("changed"); });
}
