meta {
  name: MA-AUTH-01: Login (Mobile - Phone)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mobileNumber": "9876543210",
    "password":     "Test@123",
    "company":      "AND",
    "appVersion":   "1.0.0",
    "platform":     "android",
    "osVersion":    "Android 14",
    "deviceId":     "test-device-001"
  }
}

script:post-response {
  const data = res.getBody().data;
  if (data && data.token) {
    bru.setEnvVar("token", data.token);
    bru.setVar("token", data.token);
    console.log("✅ Token saved — logged in as:", data.user && data.user.full_name, "| Role:", data.user && data.user.role_name);
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has token", function() { expect(res.getBody().data.token).to.be.a("string"); });
  test("has user", function() { expect(res.getBody().data).to.have.property("user"); });
}
