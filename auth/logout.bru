meta {
  name: Logout
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/auth/logout
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  base_url: http://192.168.1.128:5000
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("logout message", function() { expect(res.getBody().message).to.equal("Logout successful"); });
}
