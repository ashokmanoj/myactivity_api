meta {
  name: MA-AUTH-02: Register Login (Mobile)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/auth/register-login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId":    1,
    "password":  "Test@123",
    "companyId": 2
  }
}

script:post-response {
  const data = res.getBody().data;
  if (data && data.token) {
    bru.setEnvVar("token", data.token);
    bru.setVar("token", data.token);
    console.log("✅ Token saved — logged in as:", data.user && data.user.full_name, "| Role:", data.user && data.user.role_name);
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has token", function() { expect(res.getBody().data.token).to.be.a("string"); });
}
