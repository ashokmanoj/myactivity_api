meta {
  name: WA-AUTH-01: Login (Web - Email)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/auth/web-login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email":    "accounts@myactivity.com",
    "password": "Test@123",
    "company":  "AND"
  }
}

script:post-response {
  const data = res.getBody().data;
  if (data && data.token) {
    bru.setEnvVar("token", data.token);
    bru.setVar("token", data.token);
    console.log("✅ Token saved — logged in as:", data.user && data.user.full_name, "| Role:", data.user && data.user.role_name);
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has token", function() { expect(res.getBody().data.token).to.be.a("string"); });
  test("has user", function() { expect(res.getBody().data).to.have.property("user"); });
}
