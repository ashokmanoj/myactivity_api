meta {
  name: Create Block
  type: http
  seq: 3
}
post {
  url: {{base_url}}/api/v1/block
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {
    "blockName": "JORHAT EAST",
    "districtId": 1
  }
}
tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("created", function() { expect(res.getBody().message).to.include("created"); });
  test("has district_name", function() { expect(res.getBody().data).to.have.property("district_name"); });
}
docs {
  ## Create Block

  Returns the full joined block record (same shape as Get Block By ID),
  including `district_name` — not just the bare inserted row.
}