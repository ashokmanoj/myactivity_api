meta {
  name: Update Company
  type: http
  seq: 5
}

put {
  url: {{base_url}}/api/v1/company/{{companyId}}
  body: json
  auth: none
}

body:json {
  {
    "companyName": "Tata Consultancy Services Ltd",
    "email": "info@tcs.com",
    "website": "https://www.tcs.com",
    "address": "TCS House, Raveline Street, Fort, Mumbai",
    "state": "Maharashtra",
    "country": "India"
  }
}

vars:pre-request {
  baseUrl: http://192.168.1.128:3000
  companyId: 1
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("updated", function() { expect(res.getBody().message).to.include("updated"); });
  test("name actually changed", function() { expect(res.getBody().data.company_name).to.equal("Tata Consultancy Services Ltd"); });
}
