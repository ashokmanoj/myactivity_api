meta {
  name: Create Designation
  type: http
  seq: 3
}
post {
  url: {{base_url}}/api/v1/designation
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {
    "designation": "Field Engineer",
    "projectId": 1
  }
}
tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("created", function() { expect(res.getBody().message).to.include("created"); });
  test("has project_name", function() { expect(res.getBody().data).to.have.property("project_name"); });
}
docs {
  ## Create Designation

  Returns the full joined designation record (same shape as Get Designation By ID),
  including `project_name` — not just the bare inserted row.
}