meta {
  name: Delete Designation
  type: http
  seq: 5
}
delete {
  url: {{base_url}}/api/v1/designation/{{designation_id}}
  body: none
  auth: none
}
headers {
  Content-Type: application/json
}
tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("deleted", function() { expect(res.getBody().message).to.include("deleted"); });
  test("is_active flagged 0", function() { expect(res.getBody().data.is_active).to.equal(0); });
}
docs {
  ## Delete Designation

  Returns the full joined designation record as it existed just before deletion,
  with `is_active` set to `0` to reflect the new state (not just `{ id }`).
}