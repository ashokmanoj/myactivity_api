meta {
  name: MA-DIST-01: Sync Trip — START (with start selfie)
  type: http
  seq: 1
}

# Starts a new trip. The returned trip_id / uuid is used in subsequent requests.
# Send the same UUID again with endDistanceTimestamp to end the trip (see 00_upload-selfie.bru).

post {
  url: {{base_url}}/api/v1/distance/sync
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  userId: 1
  vehicleType: Bike
  startDistanceTimestamp: 1713859200000
  rmUserId: 2
  uuid: trip-uuid-001
  startSelfie: @file(/path/to/start_selfie.jpg)
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("message is STARTED", function() { expect(res.getBody().data.message).to.equal("STARTED"); });
  test("has trip_id", function() { expect(res.getBody().data).to.have.property("trip_id"); });
}
