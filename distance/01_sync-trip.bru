meta {
  name: MA-DIST-01: Sync Trip — START (with start selfie)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/distance/sync
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  userId: 1
  vehicleType: Bike
  startDistanceTimestamp: 1713859200000
  rmUserId: 2
  uuid: trip-uuid-001
  startSelfie: @file(/path/to/start_selfie.jpg)
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("message is Trip started", function() { expect(res.getBody().message).to.equal("Trip started"); });
  test("has id", function() { expect(res.getBody().data).to.have.property("id"); });
  test("has executive_name", function() { expect(res.getBody().data).to.have.property("executive_name"); });
}

docs {
  ## Sync Trip — START / END (idempotent, keyed by uuid)
  
  Returns the full joined trip record (same shape as Get Trip By ID — includes
  `executive_name`, `rm_name`, `gps_distance_km`, `unread_count`, etc.), not
  the old minimal `{ trip_id, total_distance, required_amount, message }` —
  the top-level `message` ("Trip started" / "Trip ended" / "Trip already
  exists") still tells you which branch fired.
}
