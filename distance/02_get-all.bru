meta {
  name: MA-DIST-02: Get All Distance Records
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/distance
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  page: 1
  pageSize: 10
  role: verifier
  ~userId:
  ~rmUserId:
  ~state:
  ~status:
  ~startDate: 2025-06-19
  ~endDate: 2025-06-19
  ~vehicleType: Bike,Car
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has rows array", function() { expect(res.getBody().data).to.have.property("rows"); });
  test("has total count", function() { expect(res.getBody().data).to.have.property("total"); });
  test("has page", function() { expect(res.getBody().data).to.have.property("page"); });
}

docs {
  ## Get All Distance Records

  `vehicleType` accepts a single value (`Others`) or a comma-separated list
  (`Bike,Car`) to filter by vehicle type — e.g. the web admin's "Others" tab
  passes `vehicleType=Others`, and the main travel tab passes
  `vehicleType=Bike,Car` so the two don't overlap. Omit it to see every
  vehicle type. Every row includes a `legs[]` array (populated only for
  `Others` trips — see 16_end-trip.bru).
}
