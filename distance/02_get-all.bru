meta {
  name: MA-DIST-02: Get All Distance Records
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/distance
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

params:query {
  page: 1
  pageSize: 10
  ~userId:
  ~rmUserId:
  ~state:
  ~status:
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has rows array", function() { expect(res.getBody().data).to.have.property("rows"); });
  test("has total count", function() { expect(res.getBody().data).to.have.property("total"); });
  test("has page", function() { expect(res.getBody().data).to.have.property("page"); });
}
