meta {
  name: MA-DIST-04: Create GPS Point (Single or Batch)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/distance/gps
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "points": [
      {
        "uuid": "mixed-batch-001",
        "tripId": 1,
        "latitude": 26.1445,
        "longitude": 91.7362,
        "timestamp": 1713862800000,
        "userId": 1
      },
      {
        "uuid": "mixed-batch-002",
        "tripId": 1,
        "latitude": 26.1450,
        "longitude": 91.7370,
        "timestamp": 1713862805000,
        "userId": 1
      }
    ]
  }
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has syncedCount", function() { expect(res.getBody().data).to.have.property("syncedCount"); });
  test("syncedCount is number", function() { expect(res.getBody().data.syncedCount).to.be.a("number"); });
}
