meta {
  name: MA-DIST-07: Reject Trip
  type: http
  seq: 7
}

# role: "verifier" | "rm" | "ta"
# action: "Rejected"
# comment is required when rejecting

post {
  url: {{base_url}}/api/v1/distance/approve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tripId":     1,
    "approverId": 7,
    "role":       "verifier",
    "action":     "Rejected",
    "comment":    "Distance claim does not match route. Please re-submit."
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has trip_id", function() { expect(res.getBody().data).to.have.property("trip_id"); });
}
