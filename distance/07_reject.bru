meta {
  name: MA-DIST-07: Reject Trip
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/distance/approve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tripId":     1,
    "approverId": 7,
    "role":       "verifier",
    "action":     "Rejected",
    "comment":    "Distance claim does not match route. Please re-submit."
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has id", function() { expect(res.getBody().data).to.have.property("id"); });
  test("verifier_status Rejected", function() { expect(res.getBody().data.verifier_status).to.equal("Rejected"); });
}
docs {
  ## Reject Trip

  Same endpoint as Approve. Returns the full joined trip record (same shape as
  Get Trip By ID) — not the old minimal `{ trip_id, approved_amount, message }`.
}
