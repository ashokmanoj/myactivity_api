meta {
  name: MA-DIST-08: Submit Trip (RM)
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/distance/submit
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tripId":       1,
    "submittedBy":  2
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("is_submitted 1", function() { expect(res.getBody().data.is_submitted).to.equal(1); });
}
docs {
  ## Submit Trip (RM)

  Requires the trip's `rm_status` to already be `Approved`. Returns the full
  joined trip record (same shape as Get Trip By ID) — not the old minimal
  `{ trip_id, message }`.
}
