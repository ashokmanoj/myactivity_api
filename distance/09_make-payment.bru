meta {
  name: MA-DIST-09: Make Payment (Accounts)
  type: http
  seq: 9
}

post {
  url: {{base_url}}/api/v1/distance/payment
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tripId":  1,
    "paidBy":  8,
    "amount":  294.00
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("payment_status Paid", function() { expect(res.getBody().data.payment_status).to.equal("Paid"); });
  test("has payment_at", function() { expect(res.getBody().data).to.have.property("payment_at"); });
}
docs {
  ## Make Payment (Accounts)

  Returns the full joined trip record (same shape as Get Trip By ID) — not the
  old minimal `{ trip_id, payment_at, message }`.
}
