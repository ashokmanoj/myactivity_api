meta {
  name: MA-DIST-11: Get Trip Messages
  type: http
  seq: 11
}

get {
  url: {{base_url}}/api/v1/distance/{{dist_trip_id}}/messages
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  dist_trip_id: 1
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an("array"); });
  test("messages have sender_role", function() {
    if (res.getBody().data.length > 0) {
      expect(res.getBody().data[0]).to.have.property("sender_role");
    }
  });
}
