meta {
  name: MA-DIST-12: Bulk Approve
  type: http
  seq: 12
}

post {
  url: {{base_url}}/api/v1/distance/bulk-approve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tripIds":     [1, 2, 3],
    "approverId":  15,
    "role":        "verifier",
    "comment":     "Bulk approved after review"
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an("array"); });
}
