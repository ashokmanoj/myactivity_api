meta {
  name: MA-DIST-13: Bulk Payment (Accounts)
  type: http
  seq: 13
}

post {
  url: {{base_url}}/api/v1/distance/bulk-payment
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tripIds":  [1, 2, 3],
    "paidBy":   8
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an("array"); });
  test("rows have executive_name", function() { expect(res.getBody().data[0]).to.have.property("executive_name"); });
}
docs {
  ## Bulk Payment (Accounts)

  Each item in the response array is now the full joined trip record (same
  shape as Get Trip By ID) — not the old minimal `{ trip_id, payment_at, message }`.
}
