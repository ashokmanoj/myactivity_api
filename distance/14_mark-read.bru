meta {
  name: MA-DIST-14: Mark Messages as Read
  type: http
  seq: 14
}

put {
  url: {{base_url}}/api/v1/distance/{{dist_trip_id}}/read
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  dist_trip_id: 1
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "role": "verifier"
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
}
