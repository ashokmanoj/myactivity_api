meta {
  name: MA-DIST-15: Get All Other Trips (Bus/Auto/Mixed)
  type: http
  seq: 15
}

get {
  url: {{base_url}}/api/v1/distance/other
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  page: 1
  pageSize: 10
  ~userId:
  ~startDate: 2025-07-01
  ~endDate: 2025-07-31
  ~paymentStatus:
}

docs {
  ## Get All Other Trips

  Returns paginated list of Bus/Auto/mixed-vehicle trips with their legs.

  ### Query Params
  | Param         | Description                                |
  |---------------|--------------------------------------------|
  | page          | Page number (default 1)                    |
  | pageSize      | Records per page (default 10)              |
  | userId        | Filter by executive user_id                |
  | startDate     | Filter from date (YYYY-MM-DD)              |
  | endDate       | Filter to date (YYYY-MM-DD)                |
  | paymentStatus | Processing / Pending Payment / Paid        |

  ### Response
  Each row includes a `legs` array with individual vehicle legs — `mode`,
  `payment_method`, `amount`, `photo_path`, `remarks` per leg (no from/to
  location or distance — that concept was removed). The trip itself has no
  `remarks`/`payment_method`/`amount` of its own anymore — those live only on
  each leg. `end_timestamp` is `null` while the trip is still in progress
  (started but not yet ended). `gps_distance_km` is computed from GPS points
  recorded during the trip (see 21_other-gps-point.bru).
  ```json
  {
    "data": {
      "rows": [
        {
          "id": 1,
          "uuid": "MOBILE-UUID-abc123",
          "executive_name": "John Doe",
          "start_timestamp": 1752562800000,
          "end_timestamp": 1752570000000,
          "gps_distance_km": 8.42,
          "verifier_status": "Pending",
          "rm_status": "Pending",
          "ta_status": "Pending",
          "payment_status": "Processing",
          "legs": [
            { "mode": "Bus", "payment_method": "Cash", "amount": "50.00", "photo_path": "uploads/distance-other/bike-receipt.jpg", "remarks": "Morning bus to depot" },
            { "mode": "Taxi", "payment_method": "Online", "amount": "220.00", "photo_path": "uploads/distance-other/taxi-receipt.jpg", "remarks": "Client site taxi" }
          ]
        }
      ],
      "total": 1
    }
  }
  ```
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has rows", function() { expect(res.getBody().data).to.have.property("rows"); });
  test("has total", function() { expect(res.getBody().data).to.have.property("total"); });
}
