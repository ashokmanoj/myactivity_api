meta {
  name: MA-DIST-15: Start Trip
  type: http
  seq: 15
}

post {
  url: {{base_url}}/api/v1/distance/start
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  userId: 1
  vehicleType: Others
  startOdoReading: 1200
  startDistanceTimestamp: 1713859200000
  state: Assam
  district: Jorhat
  rmUserId: 2
  uuid: trip-uuid-002
  startSelfie: @file(C:\Users\manoj\OneDrive\Pictures\133873081429583745.jpg) @contentType(image/jpeg)
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has id", function() { expect(res.getBody().data).to.have.property("id"); });
  test("has legs array", function() { expect(res.getBody().data).to.have.property("legs"); });
}

docs {
  ## Start Trip
  
  Opens a new trip for any `vehicleType` — `Bike`, `Car`, or `Others`.
  
  ### Fields
  | Field                  | Required | Description                                             |
  |------------------------|----------|-----------------------------------------------------------|
  | userId                 | Yes      | Field executive's user_id                                 |
  | vehicleType             | No       | `Bike` / `Car` / `Others`                                  |
  | startOdoReading        | No       | Odometer reading at start (Bike/Car) — meaningless for Others, omit |
  | startDistanceTimestamp | No       | Epoch ms when the trip started                             |
  | state / district       | No       | Used to resolve the per-km rate (Bike/Car only)            |
  | rmUserId               | No       | Auto-resolved from user_institution_map/reporting_rm if omitted |
  | uuid                   | No       | Client-generated ID for idempotent retries                 |
  | startSelfie            | No       | Selfie/photo file taken at the start of the trip. `multipart/form-data` is optional here — a plain JSON body with no file still works exactly as before for Bike/Car clients that don't send a selfie. |
  
  For `vehicleType: 'Others'` (Bus/Auto/Taxi/mixed-vehicle travel), the trip
  starts the same way — the modes-of-travel data (what used to be a separate
  `/distance/other/*` API) is now captured entirely at End (see
  16_end-trip.bru).
  
  ### Response
  Returns the full trip record (same shape as Get Trip By ID) with an empty
  `legs: []` (populated at End for Others trips) and `end_distance_timestamp: null`.
}
