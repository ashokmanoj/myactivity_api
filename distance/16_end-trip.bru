meta {
  name: MA-DIST-16: End Trip (Others — Bus/Auto/Taxi)
  type: http
  seq: 16
}

post {
  url: {{base_url}}/api/v1/distance/end
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  id: 1
  legs: [{"mode":"Bus","paymentMethod":"Cash","amount":50,"remarks":"Morning bus to depot","from":"Guwahati","to":"Jorhat","photo":"https://your-space.sgp1.digitaloceanspaces.com/MyActivity/leg1.jpg"},{"mode":"Taxi","paymentMethod":"Online","amount":220,"remarks":"Client site taxi","from":"Jorhat","to":"Client Site","photo":"https://your-space.sgp1.digitaloceanspaces.com/MyActivity/leg2.jpg"}]
  endSelfiePic: https://your-space.sgp1.digitaloceanspaces.com/MyActivity/end_selfie.jpg
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has 2 legs", function() { expect(res.getBody().data.legs).to.have.length(2); });
  test("end_distance_timestamp set", function() { expect(res.getBody().data.end_distance_timestamp).to.not.equal(null); });
}

docs {
  ## End Trip (Others — Bus/Auto/Taxi/mixed-vehicle only)
  
  `POST /distance/end` now only ends `vehicle_type: 'Others'` trips — Bike/Car
  trips are started **and** ended exclusively through the idempotent
  `POST /distance/sync` endpoint (01_sync-trip.bru), so this endpoint rejects
  them with `400 "Bike/Car trips are started and ended via /distance/sync, not
  /distance/end"`.
  
  This is where the modes of travel taken during an Others trip get recorded —
  replaces the old separate `/distance/other/end` API.
  
  **`legs` is required** — omitting it returns
  `400 "At least one leg is required for an Others trip"`.
  
  ### Fields
  | Field         | Required | Description                                              |
  |---------------|----------|-----------------------------------------------------------|
  | id            | Yes      | Trip id returned by Start Trip (must be `vehicleType: 'Others'`) |
  | legs          | Yes      | JSON array of legs — see format below                      |
  | endSelfiePic  | No       | Selfie/photo taken at the end of the trip — a plain text URL |

  `endSelfiePic` and each leg's `photo` are plain text URLs — upload to
  DigitalOcean Spaces first (`POST /api/v1/uploads/presigned-urls`), then send
  the resulting URL. This endpoint no longer accepts real file attachments
  (the old `paymentScreenshot` field was already dead/unused code before this
  change and has been dropped; `legPhoto1..5` are replaced by each leg's own
  `photo` field below).
  
  ### Legs JSON format
  ```json
  [
    { "mode": "Bus",  "paymentMethod": "Cash",   "amount": 50,  "remarks": "Morning bus to depot", "from": "Guwahati", "to": "Jorhat",      "photo": "https://your-space.sgp1.digitaloceanspaces.com/MyActivity/leg1.jpg" },
    { "mode": "Taxi", "paymentMethod": "Online", "amount": 220, "remarks": "Client site taxi",      "from": "Jorhat",   "to": "Client Site", "photo": "https://your-space.sgp1.digitaloceanspaces.com/MyActivity/leg2.jpg" }
  ]
  ```
  `from`/`to` are optional free-text location names for that leg (e.g. "From
  Guwahati To Jorhat") — stored as-is, not validated against any place list.
  `photo` is optional per leg.

  The trip's fare (`required_amount`/`approved_amount`) is computed
  server-side as the sum of every leg's `amount` — there is no separate
  trip-level amount field to send.

  Ending an already-ended trip is a no-op — it just returns the current state
  rather than erroring or duplicating legs.

  ### Response
  Returns the full trip record (same shape as Get Trip By ID) with the
  submitted `legs[]` (each with its own `mode`/`payment_method`/`amount`/
  `photo_path`/`remarks`/`from_location`/`to_location`) and
  `end_distance_timestamp` now set.
}
