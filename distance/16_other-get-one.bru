meta {
  name: MA-DIST-16: Get Other Trip by ID
  type: http
  seq: 16
}

get {
  url: {{base_url}}/api/v1/distance/other/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  ## Get Single Other Trip

  Returns one trip with all its legs — see 17_other-start.bru /
  18_other-end.bru for how a trip is started and ended, and
  21_other-gps-point.bru / 22_other-get-gps.bru for GPS tracking. Each leg
  carries `mode`, `payment_method`, `amount`, `photo_path`, `remarks` — no
  from/to location or distance (that concept was removed). The trip itself
  has no `remarks`/`payment_method`/`amount` — those live only per leg.
  `end_timestamp` is `null` while the trip is still in progress.
  `gps_distance_km` reflects the recorded GPS trace.

  Replace `1` in the URL with the actual trip `id`.
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has legs array", function() { expect(res.getBody().data).to.have.property("legs"); });
}
