meta {
  name: MA-DIST-17: Create Other Trip (Mobile)
  type: http
  seq: 17
}

post {
  url: {{base_url}}/api/v1/distance/other
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  userId: 5
  companyId: 2
  tripDate: 2025-07-15
  paymentMethod: Online
  amount: 350.00
  remarks: Travelled to field visit
  legs: [{"mode":"Bus","fromLocation":"Guwahati","toLocation":"Jorhat","distance":300},{"mode":"Auto","fromLocation":"Jorhat Bus Stand","toLocation":"Office","distance":5}]
  paymentScreenshot: @file(C:\Users\manoj\OneDrive\Pictures\133873081429583745.jpg) @contentType(image/jpeg)
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has id", function() { expect(res.getBody().data).to.have.property("id"); });
}

docs {
  ## Create Other Trip (from mobile)
  
  Submits a new Bus/Auto/mixed-vehicle trip. Called by the mobile app when
  the user selects "Other" vehicle type.
  
  ### Fields
  | Field             | Required | Description                                        |
  |-------------------|----------|----------------------------------------------------|
  | userId            | Yes      | The field executive's user_id                      |
  | companyId         | No       | Company ID                                         |
  | tripDate          | Yes      | Date of travel (YYYY-MM-DD)                        |
  | paymentMethod     | No       | Cash / Online (default: Cash)                      |
  | amount            | No       | Total amount paid (default: 0)                     |
  | remarks           | No       | Any notes                                          |
  | legs              | Yes      | JSON array of legs — see format below              |
  | paymentScreenshot | No       | Image file (payment proof)                         |
  
  ### Legs JSON format
  ```json
  [
    { "mode": "Bus",  "fromLocation": "Guwahati", "toLocation": "Jorhat", "distance": 300 },
    { "mode": "Auto", "fromLocation": "Jorhat Bus Stand", "toLocation": "Office", "distance": 5 }
  ]
  ```
  
  ### Response
  ```json
  { "success": true, "data": { "id": 1 } }
  ```
}
