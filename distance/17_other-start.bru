meta {
  name: MA-DIST-17: Start Other Trip (Mobile)
  type: http
  seq: 17
}

post {
  url: {{base_url}}/api/v1/distance/other/start
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "companyId": 2,
    "uuid": "trip-other-uuid-001"
  }
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has id", function() { expect(res.getBody().data).to.have.property("id"); });
  test("legs empty", function() { expect(res.getBody().data.legs).to.have.length(0); });
}

docs {
  ## Start Other Trip (from mobile)

  Opens a new "Other" (Bus/Auto/Taxi/mixed-vehicle) trip — mirrors the regular
  bike/car flow's Start/End pattern. The user then travels via one or more
  modes of transport; each one gets recorded as a "leg" when the trip is
  ended (see 18_other-end.bru).

  ### Fields
  | Field     | Required | Description                                             |
  |-----------|----------|----------------------------------------------------------|
  | companyId | No       | Company ID                                                |
  | uuid      | No       | Client-generated ID for idempotent retries — starting again with the same uuid returns the already-started trip instead of creating a duplicate |

  `userId` comes from the JWT, never the body.

  ### Response
  Returns the full trip record (same shape as `GET /distance/other/:id`) with
  an empty `legs: []`, `end_timestamp: null` (still in progress), and
  `gps_distance_km: 0`. There is no trip-level `remarks`/`payment_method`/
  `amount` — those are captured per leg at End (see 18_other-end.bru).
}
