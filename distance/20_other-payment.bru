meta {
  name: MA-DIST-20: Mark Other Trip Paid (Accounts)
  type: http
  seq: 20
}

post {
  url: {{base_url}}/api/v1/distance/other/payment
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tripId": 1,
    "paidBy": 9
  }
}

docs {
  ## Mark Other Trip as Paid

  Called by Accounts role after physically making the payment.
  Sets `payment_status = 'Paid'`.

  ### Fields
  | Field  | Required | Description            |
  |--------|----------|------------------------|
  | tripId | Yes      | ID of the other trip   |
  | paidBy | Yes      | user_id of accounts user |

  ### Response
  Returns the full trip (same shape as `GET /distance/other/:id`, including
  `legs[]` and `executive_name`) — not just the bare updated row.
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("payment_status Paid", function() { expect(res.getBody().data.payment_status).to.equal("Paid"); });
  test("has legs array", function() { expect(res.getBody().data).to.have.property("legs"); });
}
