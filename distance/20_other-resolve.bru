meta {
  name: MA-DIST-20: Resolve Other Trip Locations
  type: http
  seq: 20
}

post {
  url: {{base_url}}/api/v1/distance/other/2/resolve
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("returns legs array", function() { expect(res.getBody().data).to.be.an("array"); });
}

docs {
  ## Resolve Other Trip Locations

  For legs where `from_location` or `to_location` was entered as a time
  (e.g. "01:00 PM", "09:30"), this endpoint:

  1. Finds the nearest GPS ping in `gps_location` for the user at that time (±15 min)
  2. Reverse-geocodes the coordinates via Nominatim (OpenStreetMap)
  3. Updates `from_location` / `to_location` with the resolved place name
  4. Saves `from_time` / `to_time` (original time), `from_lat/lng`, `to_lat/lng`

  Returns the updated legs array.

  Replace `2` in the URL with the actual trip `id`.

  ### Supported time formats
  - 24-hour: `09:30`, `13:05`
  - 12-hour: `01:00 PM`, `9:30 AM`, `1:05PM`

  ### Response
  ```json
  {
    "success": true,
    "data": [
      {
        "id": 3,
        "trip_id": 2,
        "mode": "Bus",
        "from_location": "Guwahati Railway Station",
        "from_time": "01:00 PM",
        "from_lat": 26.1844,
        "from_lng": 91.7458,
        "to_location": "Jorhat Bus Stand",
        "to_time": "01:05 PM",
        "to_lat": 26.7509,
        "to_lng": 94.2037,
        "distance": 300,
        "sort_order": 0
      }
    ]
  }
  ```
}
