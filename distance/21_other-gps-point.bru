meta {
  name: MA-DIST-21: Create Other-Trip GPS Point (Single or Batch)
  type: http
  seq: 21
}

post {
  url: {{base_url}}/api/v1/distance/other/gps
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "points": [
      {
        "uuid": "other-mixed-batch-001",
        "tripId": 1,
        "latitude": 26.1445,
        "longitude": 91.7362,
        "timestamp": 1713862800000,
        "userId": 1
      },
      {
        "uuid": "other-mixed-batch-002",
        "tripId": 1,
        "latitude": 26.1450,
        "longitude": 91.7370,
        "timestamp": 1713862805000,
        "userId": 1
      }
    ]
  }
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has syncedCount", function() { expect(res.getBody().data).to.have.property("syncedCount"); });
  test("syncedCount is number", function() { expect(res.getBody().data.syncedCount).to.be.a("number"); });
}

docs {
  ## Create Other-Trip GPS Point (Single or Batch)

  Same contract as the regular flow's `POST /distance/gps`, but points attach
  to an "Other" trip (`distance_other_trip`, a separate id sequence from the
  regular flow's trips — send the correct `tripId` for this domain) instead of
  a regular bike/car trip. Used to build the map trace shown for "Other" trips
  in the web admin's Others tab, same as the regular flow.

  ### Single point
  ```json
  { "uuid": "abc-123", "tripId": 1, "latitude": 26.1445, "longitude": 91.7362, "timestamp": 1713862800000, "userId": 1 }
  ```

  ### Batch (up to 500 points)
  ```json
  { "points": [ { ...same shape as single... }, ... ] }
  ```

  `uuid` makes each point idempotent — retrying with the same uuid is a no-op,
  never a duplicate point. A point whose `tripId` doesn't exist is silently
  skipped (not an error) since retries can arrive after a trip is deleted.
}
