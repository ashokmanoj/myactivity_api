meta {
  name: Create District
  type: http
  seq: 3
}
post {
  url: {{base_url}}/api/v1/district
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {
    "districtName": "JORHAT",
    "stateCode": "AS"
  }
}
tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("created", function() { expect(res.getBody().message).to.include("created"); });
  test("has blocks", function() { expect(res.getBody().data).to.have.property("blocks"); });
}
docs {
  ## Create District

  Returns the full joined district record (same shape as Get District By ID),
  including the `blocks` array — not just the bare inserted row.

  ### Response
  ```json
  {
    "success": true,
    "data": {
      "district_id": 7,
      "district_name": "JORHAT",
      "state_code": "AS",
      "is_active": 1,
      "created_at": "2026-08-27T11:43:59.360Z",
      "updated_at": "2026-08-27T11:43:59.360Z",
      "blocks": []
    }
  }
  ```
}