tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
}

docs {
  ## Delete Documentation — DELETE /documentation/:id

  Soft delete — sets `is_active = 0`, so it drops out of `GET /documentation`
  but the record (and its files in Spaces) is kept.

  ### Response (200) — `data`: `{ id, is_active: 0 }`
}
