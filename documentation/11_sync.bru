tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("data is array", function() { expect(res.getBody().data).to.be.an("array"); });
}

docs {
  ## Sync Documentation (Mobile) — POST /documentation/sync

  Bulk-syncs reports captured offline in one call. Each entry goes through
  the same idempotent-on-uuid path as Create, so re-posting the same batch
  after a partial network failure is safe.

  Accepts **multipart/form-data** (active body above) or **JSON**. In
  form-data, send a single `reports` field holding the array as a JSON string.

  ### Request body

  | Field   | Type  | Required | Notes                                      |
  |---------|-------|----------|--------------------------------------------|
  | reports | array | yes      | each entry takes the same fields as Create; form-data: JSON string |

  ### Response (201) — `data` array, one entry per submitted report

  | Field   | Type    | Notes                                          |
  |---------|---------|------------------------------------------------|
  | uuid    | string  | echoed back, or null if not sent               |
  | success | boolean |                                                |
  | data    | object  | present when `success` — same shape as Create  |
  | error   | string  | present when `!success` — why that entry failed |
}
