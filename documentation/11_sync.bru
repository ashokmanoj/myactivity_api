meta {
  name: MA-DOC-11: Sync Documentation (Mobile)
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/v1/documentation/sync
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  reports: [{"userId":47,"uuid":"mobile-generated-uuid-1","projectId":22,"institutionId":20,"reportTypeId":7,"reportDate":"2026-10-30","hmLetterImage":"https://your-space.sgp1.digitaloceanspaces.com/MyActivity/hm-letter.jpg","files":["https://your-space.sgp1.digitaloceanspaces.com/MyActivity/photo1.jpg"]},{"userId":47,"uuid":"mobile-generated-uuid-2","projectId":22,"institutionId":20,"reportTypeId":8,"remarks":"Tool kit checked","hmLetterImage":"https://your-space.sgp1.digitaloceanspaces.com/MyActivity/hm-letter-2.jpg","attachFeedback":"https://your-space.sgp1.digitaloceanspaces.com/MyActivity/feedback-2.jpg","files":[{"url":"https://your-space.sgp1.digitaloceanspaces.com/MyActivity/toolkit.mp4"}]}]
}

