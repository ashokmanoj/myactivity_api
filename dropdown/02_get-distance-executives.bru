meta {
  name: DD-02: Get Distance Executives
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/dropdown/distance-executives
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an('array'); });
}

docs {
  Returns distinct field executives who have at least one distance_tracking record.
  Used to populate the "All Executives" filter dropdown on the Distance page.

  Response:
    [{ user_id, full_name }]
}
