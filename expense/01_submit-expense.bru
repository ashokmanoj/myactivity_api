meta {
  name: MA-EXP-01: Submit Generic Expense (Mobile)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/expense/submit
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  userId: 5
  companyId: 2
  projectId: 3
  type: expense
  purpose: Others
  hasBill: true
  amount: 500
  expenseDate: 2026-08-01
  paymentMethod: Cash
  remarks: Miscellaneous expense during field visit
  ~images: @file(/path/to/receipt.jpg)
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has expense_id", function() { expect(res.getBody().data).to.have.property("expense_id"); });
}

docs {
  ## Submit Generic Expense (Mobile)

  Use 01_submit-food-expense for Food, 01b_submit-stay-expense for Stay.

  **Image upload**: send photos as multipart field `images` (array, up to 10 files).
  Old field name `billImage` is no longer used.

  | Field       | Type    | Required | Notes                          |
  |-------------|---------|----------|--------------------------------|
  | userId      | int     | yes      | executive's user_id            |
  | companyId   | int     | yes      |                                |
  | projectId   | int     | no       |                                |
  | type        | string  | no       | `expense` (default)            |
  | purpose     | string  | no       | from /expense/purposes list    |
  | hasBill     | boolean | no       | true if bill image attached    |
  | amount      | number  | yes      |                                |
  | expenseDate | date    | no       | YYYY-MM-DD                     |
  | remarks     | string  | no       |                                |
  | images      | file[]  | no       | up to 10 photos                |
}
