meta {
  name: MA-EXP-01c: Submit Material Dispatch Expense (Mobile)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/expense/material-dispatch-submit
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  userId: 5
  companyId: 2
  projectId: 3
  type: expense
  hasBill: true
  amount: 750
  expenseDate: 2026-08-18
  driverName: Ganesh Behera
  driverNumber: 9876543210
  vehicleNumber: OD05AB1234
  paymentMethod: Online
  remarks: Material dispatch to site
  images: @file(/path/to/dispatch1.jpg)
  images: @file(/path/to/dispatch2.jpg)
  images: @file(/path/to/dispatch3.jpg)
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });

  var data = res.getBody().data;

  test("has expense_id",     function() { expect(data).to.have.property("expense_id"); });
  test("purpose is Material Dispatch", function() { expect(data.purpose).to.equal("Material Dispatch"); });
  test("has driver_name",    function() { expect(data).to.have.property("driver_name"); });
  test("has driver_number",  function() { expect(data).to.have.property("driver_number"); });
  test("has vehicle_number", function() { expect(data).to.have.property("vehicle_number"); });
  test("has amount",         function() { expect(data).to.have.property("amount"); });
  test("has payment_method", function() { expect(data).to.have.property("payment_method"); });
  test("has full_name",      function() { expect(data).to.have.property("full_name"); });
  test("has overall_status", function() { expect(data).to.have.property("overall_status"); });
  test("images array has 3", function() { expect(data.images).to.be.an("array").with.length(3); });
  test("has created_at",     function() { expect(data).to.have.property("created_at"); });
}

docs {
  ## Submit Material Dispatch Expense (Mobile) — POST /expense/material-dispatch-submit

  `purpose` is automatically set to `Material Dispatch` by the server — no need to
  send it. This purpose is also auto-registered in `GET /expense/purposes` the
  first time it's used, same as any other purpose.

  Multiple photos: send several files under the same `images` field (up to 10) —
  a plain array, no per-photo metadata needed (unlike Stay's bill/hotel split).

  ### Request Fields

  | Field         | Type    | Required | Notes                                      |
  |---------------|---------|----------|--------------------------------------------|
  | userId        | int     | yes      | executive's user_id                        |
  | companyId     | int     | yes      |                                            |
  | projectId     | int     | no       |                                            |
  | type          | string  | no       | `expense` (default)                        |
  | hasBill       | boolean | no       | true = receipt image attached              |
  | amount        | number  | yes      | total amount paid                          |
  | expenseDate   | date    | yes      | YYYY-MM-DD                                 |
  | driverName    | string  | no       | driver's name                              |
  | driverNumber  | string  | no       | driver's phone number                      |
  | vehicleNumber | string  | no       | vehicle registration number                |
  | paymentMethod | string  | no       | Cash / Online / UPI / Card (default: Cash) |
  | remarks       | string  | no       |                                            |
  | images        | file[]  | no       | up to 10 photos (field name: `images`)     |

  ### Response (201) — `data` object

  | Field          | Type     | Notes                              |
  |----------------|----------|------------------------------------|
  | expense_id     | int      | generated primary key              |
  | user_id        | int      |                                    |
  | company_id     | int      |                                    |
  | project_id     | int      |                                    |
  | type           | string   | `expense`                          |
  | purpose        | string   | `Material Dispatch`                |
  | has_bill       | boolean  |                                    |
  | amount         | number   |                                    |
  | expense_date   | string   | YYYY-MM-DD                         |
  | payment_method | string   | Cash / Online / UPI / Card         |
  | remarks        | string   |                                    |
  | driver_name    | string   |                                    |
  | driver_number  | string   |                                    |
  | vehicle_number | string   |                                    |
  | overall_status | string   | `Pending` (default)                |
  | payment_status | string   | null until paid                    |
  | created_at     | datetime | ISO 8601                           |
  | full_name      | string   | executive's name                   |
  | emp_code       | string   |                                    |
  | project_name   | string   |                                    |
  | images         | object[] | one entry per uploaded photo: `{ image_path, image_type, photo_lat, photo_lng, photo_location }` (type/lat/lng/location all null unless sent) |
}
