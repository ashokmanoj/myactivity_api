meta {
  name: MA-EXP-10: Send Message (Chat — with attachment)
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/v1/expense/1/messages
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  message: Attaching the corrected bill scan for your review.
  toRole: rm
  attachment: https://your-space.sgp1.digitaloceanspaces.com/MyActivity/corrected_bill.jpg
}

docs {
  ## Send a Chat Message with File Attachment

  Same as `09_send-message` but includes a URL in `attachment`.

  `attachment` is a plain text URL, not a file attachment — upload the file to
  DigitalOcean Spaces first (`POST /api/v1/uploads/presigned-urls`), then send
  the resulting URL here.

  The `attachment_path` in the response is that same URL, ready to use directly
  — no further resolution needed.

  ### Response
  Returns the full saved message row (`sender_name`, `sender_role`, `to_role`,
  `message`, `attachment_path`, `created_at`) — not just `{ message_id }`.
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has message_id", function() { expect(res.getBody().data).to.have.property("message_id"); });
  test("has attachment_path", function() { expect(res.getBody().data).to.have.property("attachment_path"); });
}
