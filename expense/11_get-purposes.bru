meta {
  name: MA-EXP-11: Get Expense Purposes
  type: http
  seq: 11
}

get {
  url: {{base_url}}/api/v1/expense/purposes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  ~companyId: 2
  ~appliesTo: expense
}

docs {
  ## Get Expense / Advance Purpose List

  Returns all active purposes for the expense/advance dropdown.

  ### Query params (all optional)
  | Param       | Description                                      |
  |-------------|--------------------------------------------------|
  | companyId   | Filter to company-specific purposes + global     |
  | appliesTo   | `expense` or `advance` — omit for all            |

  ### Response
  ```json
  {
    "success": true,
    "data": [
      { "purpose_id": 1, "name": "Food",   "applies_to": "both", "is_active": true, "company_id": null },
      { "purpose_id": 2, "name": "Stay",   "applies_to": "both", "is_active": true, "company_id": null },
      { "purpose_id": 3, "name": "Hotel",  "applies_to": "both", "is_active": true, "company_id": null },
      { "purpose_id": 4, "name": "Bus",    "applies_to": "both", "is_active": true, "company_id": null },
      { "purpose_id": 5, "name": "Auto",   "applies_to": "both", "is_active": true, "company_id": null },
      { "purpose_id": 6, "name": "TA",     "applies_to": "both", "is_active": true, "company_id": null },
      { "purpose_id": 7, "name": "Others", "applies_to": "both", "is_active": true, "company_id": null }
    ]
  }
  ```

  ### Auto-registration from "Other"
  New purposes don't need to be created via this API before use — submitting an
  expense (`POST /expense/submit` etc.) with a `purpose` that doesn't already exist
  automatically adds it here (scoped to that company + type), so a user picking
  "Other" and typing a custom name just works on the next submit.

  ### Manual management (any authenticated user, not just superusers)
  - **Add purpose**: `POST /api/v1/expense/purposes` with `{ name, appliesTo, companyId }`
  - **Remove purpose**: `DELETE /api/v1/expense/purposes/:purposeId`
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an("array"); });
  test("has name field", function() { expect(res.getBody().data[0]).to.have.property("name"); });
}
