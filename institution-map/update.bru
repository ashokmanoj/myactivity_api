meta {
  name: Update Map
  type: http
  seq: 4
}
put {
  url: {{base_url}}/api/v1/institution-map/{{map_id}}
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {
    "projectId": 2,
    "instituteId": 1
  }
}
tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("updated", function() { expect(res.getBody().message).to.include("updated"); });
  test("has institution_name", function() { expect(res.getBody().data).to.have.property("institution_name"); });
}
docs {
  ## Update Map

  Returns the full joined mapping record (same shape as Get Map By ID) — not just
  the bare updated row.
}
