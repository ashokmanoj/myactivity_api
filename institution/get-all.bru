meta {
  name: Get All institutions
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/institution
  body: none
  auth: none
}

params:query {
  ~projectId: 1
  ~districtId: 1
  ~lastSyncedAt: 2025-01-01T00:00:00Z
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  base_url: http://192.168.1.128:5000
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("data is array", function() { expect(res.getBody().data).to.be.an("array"); });
  test("has relations", function() { if(res.getBody().data.length > 0) { expect(res.getBody().data[0]).to.have.property("project"); expect(res.getBody().data[0]).to.have.property("district"); } });
}
