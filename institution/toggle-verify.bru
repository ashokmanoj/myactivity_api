meta {
  name: Toggle institution Verification
  type: http
  seq: 7
}
put {
  url: {{base_url}}/api/v1/institution/{{institute_id}}/verify
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {
    "userId": 1
  }
}
tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("has project_name", function() { expect(res.getBody().data).to.have.property("project_name"); });
}
docs {
  ## Toggle institution Verification

  Flips `is_verified` for the institution and records who verified it / when.
  Returns the full joined institution record (same shape as Get institution By ID),
  including `project_name`, `district_name`, `block_name` — not just the 3-column
  `{ institute_id, is_verified, verified_at }` it used to return.
}
