meta {
  name: Create Location
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/location
  body: multipartForm
  auth: none
}

headers {
}

body:multipart-form {
  userId: 1
  locationName: Office HQ
  locationType: office
  lat: 12.971599
  lon: 77.594566
  geoAddress: Bengaluru, Karnataka
  geoPincode: 560001
  description: Main office location
  ~institutionId: 1
  ~photos: @file(C:/path/to/photo1.jpg)
  ~photos: @file(C:/path/to/photo2.jpg)
}

vars:pre-request {
  base_url: http://192.168.1.128:5000
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
}