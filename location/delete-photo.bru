meta {
  name: Delete Photo
  type: http
  seq: 7
}

delete {
  url: {{base_url}}/api/v1/location/photo/1
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  base_url: http://192.168.1.128:5000
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has photos array", function() { expect(res.getBody().data).to.have.property("photos"); });
}
docs {
  ## Delete Photo

  Returns the full parent location record (same shape as Get Location By ID,
  including the remaining `photos[]`) — not just the deleted photo row.
}