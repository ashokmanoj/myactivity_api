meta {
  name: Delete Location
  type: http
  seq: 6
}

delete {
  url: {{base_url}}/api/v1/location/1
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  base_url: http://192.168.1.128:5000
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("is_active flagged 0", function() { expect(res.getBody().data.is_active).to.equal(0); });
}
docs {
  ## Delete Location

  Returns the full joined location record (same shape as Get Location By ID,
  including `photos[]`) as it existed just before deletion, with `is_active`
  set to `0` — not just `{ locationId }`.
}