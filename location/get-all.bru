meta {
  name: Get All Locations
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/location
  body: none
  auth: none
}

params:query {
  ~userId: 1
  ~lastSyncedAt: 2025-01-01T00:00:00Z
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  base_url: http://192.168.1.218:5001
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an("array"); });
}
