meta {
  name: Get Locations by User ID
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/location/user/1
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  base_url: http://192.168.1.128:5000
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an("array"); });
}