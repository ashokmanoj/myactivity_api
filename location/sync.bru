meta {
  name: Sync Location
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/location/sync
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": 1,
    "locationName": "Synced Location",
    "locationType": "field",
    "lat": 12.971599,
    "lon": 77.594566,
    "geoAddress": "Bengaluru, Karnataka",
    "geoPincode": "560001",
    "description": "Synced from mobile"
  }
}

vars:pre-request {
  base_url: http://192.168.1.128:5000
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
}