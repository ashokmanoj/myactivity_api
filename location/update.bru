meta {
  name: Update Location
  type: http
  seq: 5
}

put {
  url: {{base_url}}/api/v1/location/1
  body: multipartForm
  auth: none
}

headers {
}

body:multipart-form {
  locationName: Updated Office
  locationType: branch
  lat: 12.971599
  lon: 77.594566
  geoAddress: Bengaluru Updated
  geoPincode: 560002
  description: Updated description
  ~projectId: 1
  ~projectName: Assam ICT
  ~institutionId: 1
  ~institutionName: Jorhat HSS
  ~photos: https://your-space.sgp1.digitaloceanspaces.com/MyActivity/new-photo.jpg
}

vars:pre-request {
  base_url: http://192.168.1.128:5000
}

docs {
  ## Update Location

  `photos` is one or more plain text URLs, not file attachments — upload each
  photo to DigitalOcean Spaces first (`POST /api/v1/uploads/presigned-urls`),
  then repeat the `photos` field with each resulting URL.

  Omitted fields keep their current value. Changing `projectId` /
  `institutionId` without the matching name refreshes the name from the master.
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
}