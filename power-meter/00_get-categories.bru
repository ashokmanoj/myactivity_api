meta {
  name: PWM-00: Get Power Meter Categories
  type: http
  seq: 0
}

get {
  url: {{base_url}}/api/v1/power-meter/categories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  ~all: true
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an('array'); });
  test("has Working category", function() {
    const names = res.getBody().data.map(c => c.category_name);
    expect(names).to.include('Working');
  });
  test("has Not Working category", function() {
    const names = res.getBody().data.map(c => c.category_name);
    expect(names).to.include('Not Working');
  });
}

docs {
  Returns power meter status categories ordered by sort_order.

  By default (no query param, what the mobile app uses to populate the meter
  status dropdown) only active categories are returned, without an is_active field:
    [
      { "category_id": 1, "category_name": "Working",     "sort_order": 1 },
      { "category_id": 2, "category_name": "Not Working", "sort_order": 2 }
    ]

  `?all=true` (used by the web Admin Dashboard) returns every row, including
  deactivated ones, each with is_active — for management, not the mobile dropdown:
    [
      { "category_id": 1, "category_name": "Working", "sort_order": 1, "is_active": 1 },
      ...
    ]

  Manage categories via the write endpoints instead of raw SQL now:
  see 08_create-category.bru, 09_update-category.bru, 10_delete-category.bru.
}
