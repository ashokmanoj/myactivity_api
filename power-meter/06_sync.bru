meta {
  name: PWM-06: Sync from Mobile
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/power-meter/sync
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  uuid: MOBILE-PWM-abc123-xyz
  projectId: 1
  institutionId: 10
  userId: 5
  entryType: POWER_METER
  meterStatus: Not Working
  meterReading: 987.50
  ~receiptDurationId: 4
  submittedAt: 2025-06-19T10:30:00Z
  comments: Display panel damaged. Wiring looks loose.
  gpsLat: 26.1445
  gpsLng: 91.7362
  ~photo: @file(/path/to/meter-photo.jpg)
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has meter_id", function() { expect(res.getBody().data).to.have.property("meter_id"); });
}

docs {
  Mobile offline sync endpoint — call when device comes online.
  Safe to call multiple times (idempotent on uuid).

  Content-Type: multipart/form-data

  Always required:
    uuid          : unique ID generated by mobile for this reading
    projectId     : project ID
    institutionId : institution ID
    userId        : field executive user_id
    entryType     : "POWER_METER" | "RECEIPT"

  Required for POWER_METER:
    meterStatus   : "Working" | "Not Working"

  Optional for POWER_METER:
    meterReading  : value shown on the meter display

  Required for RECEIPT:
    receiptDurationId : ID from GET /power-meter/receipt-durations

  Always optional:
    submittedAt : ISO date string — defaults to NOW()
    comments    : free text
    gpsLat      : GPS latitude
    gpsLng      : GPS longitude
    photo       : single image file (JPG/JPEG/PNG/WEBP, max 10 MB)

  Response:
    { "success": true, "data": { "meter_id": 12 }, "message": "Sync successful" }

  Notes:
  - Same uuid is upserted — safe to call multiple times on retry
  - is_synced flag is set to 1 for mobile-synced records
  - If no new photo is uploaded, existing image_path is preserved
}
