meta {
  name: PWM-07: Get Receipt Durations
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/v1/power-meter/receipt-durations
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  ~all: true
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an('array'); });
  test("has at least one duration", function() { expect(res.getBody().data.length).to.be.above(0); });
  test("each item has duration_label", function() {
    res.getBody().data.forEach(d => expect(d).to.have.property('duration_label'));
  });
}

docs {
  Returns receipt duration options ordered by sort_order.

  By default (no query param, what the mobile app uses to populate the Receipt
  Duration dropdown) only active durations are returned, without an is_active field:
    [
      { "duration_id": 1, "duration_label": "Jan 2023 to Sep 2023", "sort_order": 1 },
      ...
    ]

  `?all=true` (used by the web Admin Dashboard) returns every row, including
  deactivated ones, each with is_active — for management, not the mobile dropdown.

  Manage durations via the write endpoints instead of raw SQL now:
  see 08_create-duration.bru, 09_update-duration.bru, 10_delete-duration.bru.
}
