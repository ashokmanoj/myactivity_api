meta {
  name: PWM-07: Get Receipt Durations
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/v1/power-meter/receipt-durations
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an('array'); });
  test("has at least one duration", function() { expect(res.getBody().data.length).to.be.above(0); });
  test("each item has duration_label", function() {
    res.getBody().data.forEach(d => expect(d).to.have.property('duration_label'));
  });
}

docs {
  Returns all active receipt duration options ordered by sort_order.
  Use this to populate the Receipt Duration dropdown in the mobile app.

  No query params needed.

  Response:
    [
      { "duration_id": 1, "duration_label": "Jan 2023 to Sep 2023",   "sort_order": 1 },
      { "duration_id": 2, "duration_label": "Aug 2023 to Dec 2023",   "sort_order": 2 },
      { "duration_id": 3, "duration_label": "Oct 2023 to Dec 2023",   "sort_order": 3 },
      { "duration_id": 4, "duration_label": "Nov 2023 to Dec 2023",   "sort_order": 4 },
      { "duration_id": 5, "duration_label": "April 2024 to May 2024", "sort_order": 5 },
      { "duration_id": 6, "duration_label": "Jan 2024 to March 2024", "sort_order": 6 }
    ]

  To add a new duration: INSERT INTO myactivity.power_meter_receipt_duration (duration_label, sort_order).
  To disable: UPDATE myactivity.power_meter_receipt_duration SET is_active = 0 WHERE duration_id = ?;
}
