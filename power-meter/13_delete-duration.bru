meta {
  name: PWM-13: Delete Receipt Duration
  type: http
  seq: 13
}

delete {
  url: {{base_url}}/api/v1/power-meter/receipt-durations/{{duration_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("deleted", function() { expect(res.getBody().message).to.include("deleted"); });
}

docs {
  Soft delete — sets is_active = 0. Deactivated durations no longer appear in the
  mobile dropdown (GET /power-meter/receipt-durations) but still show in the admin
  view (GET /power-meter/receipt-durations?all=true).
}
