meta {
  name: PM-04: Submit PM Session (with Photos)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/pm/submit
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  projectId: 1
  institutionId: 10
  answers: [{"questionId":1,"qId":"Q_PM_001","answer":"YES"},{"questionId":2,"qId":"Q_PM_002","answer":"NO"},{"questionId":3,"qId":"Q_PM_003","answer":"YES"},{"questionId":4,"qId":"Q_PM_004","answer":"N/A"},{"questionId":5,"qId":"Q_PM_005","answer":"YES"},{"questionId":6,"qId":"Q_PM_006","answer":"YES"},{"questionId":7,"qId":"Q_PM_007","answer":"NO"},{"questionId":8,"qId":"Q_PM_008","answer":"YES"},{"questionId":9,"qId":"Q_PM_009","answer":"N/A"},{"questionId":10,"qId":"Q_PM_010","answer":"YES"}]
  photo_3: @file(/path/to/photo_for_question3.jpg)
  photo_7: @file(/path/to/photo_for_question7.jpg)
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has pm_id", function() { expect(res.getBody().data).to.have.property("pm_id"); });
}

docs {
  Submit a full PM inspection session. Photos are optional per question.
  
  Content-Type: multipart/form-data
  
  Text fields (required):
    projectId     : project being inspected
    institutionId : institution being inspected
    answers       : JSON string — array of { questionId, qId, answer }
                    answer values: "YES" | "NO" | "N/A"
  
  File fields (optional — one per question that has a photo):
    photo_<questionId> : image file (JPG/JPEG/PNG/WEBP, max 10 MB)
    e.g. photo_1, photo_3, photo_7
  
  The server matches photo_<questionId> to the answer with that questionId
  and stores the file path in the pm_answer table automatically.
  
  Response:
    { "success": true, "data": { pm_id, uuid, status, ... } }
}
