meta {
  name: PM-01: Get All Questions
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/pm/questions
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an("array"); });
  test("each question has q_id", function() {
    res.getBody().data.forEach(q => expect(q).to.have.property("q_id"));
  });
}
