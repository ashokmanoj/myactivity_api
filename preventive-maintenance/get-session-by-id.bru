meta {
  name: PM-06: Get Session Detail by ID
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/v1/pm/sessions/1
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Returns full detail of a single PM session including all answers.
  Replace "1" in the URL with the actual pm_id.

  Response: array of rows — one row per answer (LEFT JOIN).
  Session-level fields repeated on every row:
    pm_id, uuid, status, project_id, project_name,
    institution_id, institution_name, institute_code,
    user_id, full_name, emp_code,
    total_questions, answered_count, started_at, submitted_at

  Answer-level fields (null if no answers yet):
    answer_id, question_id, q_id, question, q_type,
    answer, photo_path, sort_order
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("data is array", function() { expect(res.getBody().data).to.be.an("array"); });
  test("has pm_id", function() { expect(res.getBody().data[0]).to.have.property("pm_id"); });
}
