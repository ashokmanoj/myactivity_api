meta {
  name: PM-07: Sync from Mobile
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/pm/sync
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "uuid": "MOBILE-UUID-abc123-xyz",
    "projectId": 1,
    "institutionId": 10,
    "userId": 5,
    "submittedAt": "2025-05-28T10:30:00Z",
    "totalQuestions": 10,
    "answeredCount": 9,
    "gpsLat": 12.9716,
    "gpsLng": 77.5946,
    "answers": [
      { "questionId": 1, "qId": "Q_PM_001", "answer": "YES",  "photoPath": null },
      { "questionId": 2, "qId": "Q_PM_002", "answer": "NO",   "photoPath": null },
      { "questionId": 3, "qId": "Q_PM_003", "answer": "YES",  "photoPath": "/uploads/pm/photo1.jpg" },
      { "questionId": 4, "qId": "Q_PM_004", "answer": "N/A",  "photoPath": null },
      { "questionId": 5, "qId": "Q_PM_005", "answer": "YES",  "photoPath": null },
      { "questionId": 6, "qId": "Q_PM_006", "answer": "YES",  "photoPath": null },
      { "questionId": 7, "qId": "Q_PM_007", "answer": "NO",   "photoPath": null },
      { "questionId": 8, "qId": "Q_PM_008", "answer": "YES",  "photoPath": null },
      { "questionId": 9, "qId": "Q_PM_009", "answer": "N/A",  "photoPath": null }
    ]
  }
}

docs {
  Mobile sync endpoint — call this when the device comes online.
  Safe to call multiple times (idempotent on uuid).

  Required fields:
    uuid          (string)   : unique ID generated by mobile for this session
    projectId     (int)      : project
    institutionId (int)      : institution
    userId        (int)      : field executive user_id
    submittedAt   (ISO date) : when the user pressed Submit on the device
    answers       (array)    : list of { questionId, qId, answer, photoPath? }
      answer values: "YES" | "NO" | "N/A"
      photoPath: relative path of uploaded photo, or null

  Optional fields:
    totalQuestions (int)    : defaults to answers.length if omitted
    answeredCount  (int)    : defaults to count of non-null answers if omitted
    gpsLat         (float)  : GPS latitude at time of inspection
    gpsLng         (float)  : GPS longitude at time of inspection

  Response:
    { "success": true, "data": { "pm_id": 42 }, "message": "Sync successful" }

  Notes:
  - If a session with this uuid already exists it will be updated (upsert).
  - Answers are upserted individually — re-syncing is safe.
  - is_synced flag is set to 1 automatically for mobile-synced sessions.
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has pm_id", function() { expect(res.getBody().data).to.have.property("pm_id"); });
}
