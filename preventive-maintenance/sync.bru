meta {
  name: PM-07: Sync from Mobile (with Photos)
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/pm/sync
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  uuid: MOBILE-UUID-abc123-xyz
  projectId: 1
  institutionId: 10
  userId: 5
  submittedAt: 2025-05-28T10:30:00Z
  totalQuestions: 10
  answeredCount: 9
  gpsLat: 12.9716
  gpsLng: 77.5946
  answers: [{"questionId":1,"qId":"Q_PM_001","answer":"YES"},{"questionId":2,"qId":"Q_PM_002","answer":"NO"},{"questionId":3,"qId":"Q_PM_003","answer":"YES"},{"questionId":4,"qId":"Q_PM_004","answer":"N/A"},{"questionId":5,"qId":"Q_PM_005","answer":"YES"},{"questionId":6,"qId":"Q_PM_006","answer":"YES"},{"questionId":7,"qId":"Q_PM_007","answer":"NO"},{"questionId":8,"qId":"Q_PM_008","answer":"YES"},{"questionId":9,"qId":"Q_PM_009","answer":"N/A"}]
  photo_3: @file(/path/to/photo_q3.jpg)
  photo_7: @file(/path/to/photo_q7.jpg)
}

docs {
  Mobile offline sync endpoint — call when device comes online.
  Safe to call multiple times (idempotent on uuid).
  Photos are submitted in the same call as answers.

  Content-Type: multipart/form-data

  Text fields (required):
    uuid          : unique ID generated by mobile for this session
    projectId     : project
    institutionId : institution
    userId        : field executive user_id
    submittedAt   : ISO date string (when user pressed Submit on device)
    answers       : JSON string — array of { questionId, qId, answer }
                    answer values: "YES" | "NO" | "N/A"

  Text fields (optional):
    totalQuestions : defaults to answers.length
    answeredCount  : defaults to count of non-null answers
    gpsLat         : GPS latitude at time of inspection
    gpsLng         : GPS longitude at time of inspection

  File fields (optional — one per question that has a photo):
    photo_<questionId> : image file (JPG/JPEG/PNG/WEBP, max 10 MB)
    e.g. photo_1, photo_3, photo_7

  Photo matching logic:
    - Uploaded file photo_3 → stored at /uploads/pm/<uuid>.jpg
    - photo_path saved in pm_answer row where question_id = 3
    - If no file uploaded for a question, answer is saved without photo

  Response:
    { "success": true, "data": { "pm_id": 42 }, "message": "Sync successful" }

  Notes:
  - Session with same uuid → upserted (no duplicate)
  - Answers are upserted individually — re-syncing replaces old values
  - is_synced flag is set to 1 for mobile-synced sessions
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has pm_id", function() { expect(res.getBody().data).to.have.property("pm_id"); });
}
