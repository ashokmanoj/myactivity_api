meta {
  name: PM-09: Update Question
  type: http
  seq: 9
}

put {
  url: {{base_url}}/api/v1/pm/questions/{{question_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "question": "Is the school library functional and stocked?"
  }
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("updated", function() { expect(res.getBody().message).to.include("updated"); });
  test("question actually changed", function() { expect(res.getBody().data.question).to.equal("Is the school library functional and stocked?"); });
}
