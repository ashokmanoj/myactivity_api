meta {
  name: Update State
  type: http
  seq: 4
}
put {
  url: {{base_url}}/api/v1/state/{{state_id}}
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {
    "stateName": "Assam Updated"
  }
}
tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("updated", function() { expect(res.getBody().message).to.include("updated"); });
  test("name actually changed", function() { expect(res.getBody().data.state_name).to.equal("Assam Updated"); });
}
