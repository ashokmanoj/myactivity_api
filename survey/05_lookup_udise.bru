meta {
  name: Lookup School by UDISE
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/survey/lookup?institute_code=INST004
  body: none
  auth: bearer
}

params:query {
  institute_code: INST004
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status 200 or 404", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
  test("Has schoolName when found", function() {
    if (res.getStatus() === 200) {
      expect(res.getBody().data).to.have.property("schoolName");
    }
  });
}

docs {
  Auto-fill school details by UDISE code.
  Used by mobile app — when user types a UDISE code, call this API.
  If the school was surveyed before, returns pre-filled details.
  Returns 404 if UDISE code is not found in any previous survey.
  
  Response fields (camelCase, ready to use in form):
    schoolName, mediumOfInstruction, udiseCode,
    village, block, district, pin,
    distanceFromBlock, distanceFromDistrictHq,
    hmName, hmContact, hmEmail, supportingStaffContact
}
