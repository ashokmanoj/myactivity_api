meta {
  name: Lookup School by Institute Code
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/survey/lookup?institute_code=INST004
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Auto-fill school details by institute_code from the institution master table.
  Used by mobile: user types institute code → form auto-fills school name, district, block, pin.

  Query param:
    code  (required) — value of institute_code column in institution table

  Response fields:
    instituteId, instituteCode, schoolName,
    district, block, pin, address, latitude, longitude

  Returns 404 if code not found or institution is inactive.
}

tests {
  test("Status 200 or 404", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
  test("Has schoolName when found", function() {
    if (res.getStatus() === 200) {
      expect(res.getBody().data).to.have.property("schoolName");
    }
  });
}
