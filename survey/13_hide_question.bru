meta {
  name: SURVEY-13: Hide Survey Question
  type: http
  seq: 13
}

delete {
  url: {{base_url}}/api/v1/survey/questions/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  ## Hide Survey Question

  Soft-delete — sets `is_active = 0`, the same flag
  `GET /survey/questions` filters on by default. The question and any
  answers already given to it are kept, just excluded from what the mobile
  app fetches going forward. Reversible via
  `PUT /survey/questions/:id` with `{ "isActive": true }`.
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("is_active is 0", function() { expect(res.getBody().data.is_active).to.equal(0); });
}
