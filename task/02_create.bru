meta {
  name: TASK-02: Create Task
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/task
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "categoryId": 1,
    "subCategoryId": 1,
    "projectId": 1,
    "designation": "Technical Executive",
    "district": "Kamrup",
    "block": "Block A",
    "priority": "Medium",
    "executiveId": 5,
    "institutionId": 10,
    "startDate": "2026-06-01",
    "endDate": "2026-06-30",
    "intervalType": "Month",
    "remarks": "Monthly routine check",
    "gpsLat": 26.1445,
    "gpsLng": 91.7362
  }
}

tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("success true", function() { expect(res.getBody().success).to.equal(true); });
  test("has task_id", function() { expect(res.getBody().data).to.have.property('task_id'); });
  test("has category_name", function() { expect(res.getBody().data).to.have.property('category_name'); });
}

docs {
  Creates a new task and assigns it to an executive.

  Required:
    categoryId, subCategoryId, startDate, endDate

  Optional:
    projectId, designation, district, block, priority (default: Medium),
    executiveId, institutionId, intervalType, intervalDays, remarks,
    gpsLat, gpsLng (decimal degrees — sent by mobile app at time of task creation)

  Response:
    Full joined task record (same shape as GET /task's list items — includes
    project_name, category_name, sub_category_name, executive_name, emp_code,
    institution_name, institute_code, institution_latitude/longitude) — not
    just the bare inserted task_list row.
}
