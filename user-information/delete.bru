meta {
  name: Delete User Information (Soft)
  type: http
  seq: 7
}
delete {
  url: {{base_url}}/api/v1/user-information/{{user_info_id}}
  body: none
  auth: none
}
headers {
  Content-Type: application/json
}
tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("deleted", function() { expect(res.getBody().message).to.include("deleted"); });
  test("is_active flagged 0", function() { expect(res.getBody().data.is_active).to.equal(0); });
}
docs {
  ## Delete User Information (Soft)

  Returns the full joined record as it existed just before deactivation, with
  `is_active` set to `0` to reflect the new state (not just the bare updated row).
}