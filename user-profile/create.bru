tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("state_of_posting saved", function() { expect(res.getBody().data.state_of_posting).to.equal("Assam"); });
}

docs {
  ## Create User Profile

  Full "Create User (Full Information)" form. The web form sends this as
  multipart/form-data (with optional `photo`, `aadhar`, `pan`, `bank` files);
  JSON works for text-only testing.

  Required by the API: `empCode`, `fullName`, `dateOfBirth`, `gender`,
  `mobileNumber`, `email`. The web form additionally requires every field
  marked `*` there, including `stateOfPosting`.

  Professional Information:
  - `roleId` — role id (e.g. 10 = Field Executive). Web form defaults to 10 when blank.
  - `executiveName` — web form pre-fills it from `fullName` (editable).
  - `stateOfPosting` — web form pre-fills it from `payrollGroup` (editable);
    District of Posting options are filtered by this state.
  - `districtOfPosting` — optional; multiple districts as a comma-separated string.
}
