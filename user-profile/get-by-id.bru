meta {
  name: Get User Profile By ID
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/user-profile/1
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("includes role_id", function() { expect(res.getBody().data).to.have.property("role_id"); });
}

docs {
  ## Get User Profile By ID

  `GET /api/v1/user-profile/:userInfoId` — active users only.

  Response includes `role_id` (from user_information), `state_of_posting`,
  `district_of_posting` (comma-separated) and `executive_name`.
}
