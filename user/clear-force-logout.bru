meta {
  name: Clear Force Logout (Superuser only)
  type: http
  seq: 9
}
delete {
  url: {{base_url}}/api/v1/user/{{user_id}}/force-logout
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("force_logout_at cleared", function() { expect(res.getBody().data.force_logout_at).to.equal(null); });
  test("has user_info_id", function() { expect(res.getBody().data).to.have.property("user_info_id"); });
}
docs {
  ## Clear Force Logout (Superuser only)

  Clears `force_logout_at` on the target user. Requires the caller to have the
  `Superuser` role.

  Returns the full joined user record (same shape as Get User By ID) with
  `force_logout_at: null` — not just `{ user_id, full_name }`.
}
