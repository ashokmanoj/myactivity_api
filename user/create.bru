meta {
  name: Create User (user_tbl)
  type: http
  seq: 4
}
post {
  url: {{base_url}}/api/v1/user
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {
    "empCode":      "EMP001",
    "fullName":     "Rahul Sharma",
    "dateOfBirth":  "1995-06-15",
    "gender":       "Male",
    "mobileNumber": "9876543210",
    "email":        "rahul.sharma@myactivity.com",
    "nationality":  "Indian",
    "companyId":    2
  }
}
tests {
  test("Status 201", function() { expect(res.getStatus()).to.equal(201); });
  test("created", function() { expect(res.getBody().message).to.include("created"); });
  test("has user_id", function() { expect(res.getBody().data).to.have.property("user_id"); });
  test("has emp_code", function() { expect(res.getBody().data.emp_code).to.equal("EMP001"); });
}
docs {
  ## Create User (user_tbl)

  Returns the full joined user record (same shape as Get User By ID), including
  `user_info_id`, `designation_id`, `department`, `company_id`, `perm_address`,
  `curr_address` from the linked `user_information` row — not just the bare
  `user_tbl` row.
}