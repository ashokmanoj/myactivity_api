meta {
  name: Delete User - Soft (user_tbl)
  type: http
  seq: 6
}
delete {
  url: {{base_url}}/api/v1/user/{{user_id}}
  body: none
  auth: none
}
headers {
  Content-Type: application/json
}
tests {
  test("Status 200", function() { expect(res.getStatus()).to.equal(200); });
  test("deleted", function() { expect(res.getBody().message).to.include("deleted"); });
  test("is_active is 0", function() { expect(res.getBody().data.is_active).to.equal(0); });
}
docs {
  ## Delete User - Soft (user_tbl)

  Returns the full joined user record as it existed just before deactivation,
  with `is_active` set to `0` to reflect the new state (not just the bare
  updated row).
}